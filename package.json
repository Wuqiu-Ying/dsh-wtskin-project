{
  "name": "dsh-wtskin-project",
  "version": "3.0.8",
  "description": "War Thunder user-skin studio for DSH (v3): agent preset, floating quad picker, WTSP projects, final-pixel quads, normal maps and self-checking exports.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "war-thunder",
    "skin",
    "camouflage",
    "uv"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js"
  },
  "files": [
    "lib",
    "preset",
    "client",
    "python",
    "presets",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "test": "node tests/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wuqiu-Ying/dsh-wtskin-project.git"
  },
  "homepage": "https://github.com/Wuqiu-Ying/dsh-wtskin-project#readme",
  "bugs": {
    "url": "https://github.com/Wuqiu-Ying/dsh-wtskin-project/issues"
  },
  "license": "MIT"
}
