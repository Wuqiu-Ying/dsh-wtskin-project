{
  "name": "dsh-wtskin-project",
  "version": "2.1.0",
  "description": "War Thunder user-skin studio for DSH (v2): mode preset, right-sidebar quad picker, final-pixel quad semantics, normal-map generation and self-checking exports.",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "war-thunder", "skin", "camouflage", "uv"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js"
  },
  "files": ["lib", "client", "python", "presets", "assets", "cordis.patch.yml", "README.md", "CHANGELOG.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  },
  "scripts": {
    "test": "node tests/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wuqiu-Ying/dsh-wtskin-project.git"
  },
  "homepage": "https://github.com/Wuqiu-Ying/dsh-wtskin-project#readme",
  "bugs": {
    "url": "https://github.com/Wuqiu-Ying/dsh-wtskin-project/issues"
  },
  "license": "MIT"
}
